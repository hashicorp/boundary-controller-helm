# Ignore VCS and CI metadata
.git/
.github/
.act/
.gitignore
.trivyignore

# Ignore local/editor artifacts
.DS_Store
.idea/
.vscode/
*.swp
*.tmp
*.bak

# Ignore Helm chart archives
*.tgz

# Ignore local project-only files not needed in chart packages
Makefile
CONTRIBUTING.md
docs/
kubescape-exceptions.json
/tests/
example-config/
local-values.yaml
my-values.yaml

# Ignore generated validation and security scan output
rendered.yaml
kubescape-output.json
trivy-output.txt
